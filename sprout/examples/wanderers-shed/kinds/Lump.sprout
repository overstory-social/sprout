kind Lump {
  :names ["lump", "clay", "lump of clay"]
  :takeable true
  :wedged false
  prose "A lump of stoneware the size of a grapefruit, cold and heavy and perfect."

  describe {
    if (self.get(:wedged)) { text "A lump of stoneware, wedged into a smooth cone, ready for the wheel." }
    else { text "A lump of stoneware the size of a grapefruit, cold and heavy and perfect." }
  }

  wedge when (!self.get(:wedged)) {
    grammar "wedge [self]"
    grammar "wedge the clay"
    self.set(:wedged, true)
    say "You push the heel of your hand through it, fold, turn, push again, until the air is out and it is one thing."
  }

  scrap {
    grammar "throw [self] back"
    grammar "scrap [self]"
    say "Back into the scraps bucket it goes. Nothing is wasted here."
    destroy self
  }

  on :spawned (from) {
    say "You draw the wire through and lift out a lump the size of a grapefruit, cold and heavy and perfect."
  }
}
