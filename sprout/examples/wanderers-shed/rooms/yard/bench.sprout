object bench {
  :takeable false
  :remembers [rested: false]
  prose "A bench of two scaffold planks on breeze blocks, warm where the sun has been on it."

  describe {
    if (actor.recall(:rested) == true) {
      text "The bench, with the shape of you still in the warmth of it."
    } else {
      text "A bench of two scaffold planks on breeze blocks, warm where the sun has been on it."
    }
  }

  sit_a_while {
    grammar "sit a while"
    actor.remember(:rested, true)
    say "You sit. The garden does what gardens do. Nothing needs you for a minute."
  }
}
