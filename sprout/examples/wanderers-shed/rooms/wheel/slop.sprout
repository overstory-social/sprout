object slop {
  :name "Slop bucket"
  :takeable false
  :remembers [found_rib: false]
  prose "A bucket of grey water with a sponge afloat in it and, somewhere at the bottom, everything that was ever dropped here."

  describe {
    if (actor.recall(:found_rib) == true) {
      text "The slop bucket, a little clearer for your having fished about in it."
    } else {
      text "A bucket of grey water with a sponge afloat in it and, somewhere at the bottom, everything that was ever dropped here."
    }
  }

  wring_out_the_sponge {
    grammar "wring out the sponge"
    say "Grey water runs up your arm to the elbow. Now you are a potter."
  }

  feel_about_at_the_bottom when (actor.recall(:found_rib) == false) {
    grammar "feel about at the bottom"
    actor.remember(:found_rib, true)
    say "Your fingers close on a wooden rib somebody lost a year ago. Keep it; that is the rule here."
  }
}
