object kickwheel in wheel {
  :name "Kick wheel"
  :stage one_of [bare, centred, open, cup] default bare
  :takeable false
  :remembers [cups: 0 min 0 max 99]
  prose "A kick wheel with a flywheel of poured concrete, the head scraped clean, waiting."

  describe {
    if (self.get(:stage) == "centred") {
      text "A lump sits centred on the wheel head, still as a stone while everything around it turns."
    } else if (self.get(:stage) == "open") {
      text "The lump is opened: a thick-walled little well, the beginnings of something."
    } else if (self.get(:stage) == "cup") {
      text "A cup rises from the wheel head, walls thin, rim just this side of true."
    } else {
      text "A kick wheel with a flywheel of poured concrete, the head scraped clean, waiting."
    }
  }

  slap_a_lump_on_and_centre_it when (self.get(:stage) == "bare") {
    grammar "slap a lump on and centre it"
    self.set(:stage, "centred")
    say "You kick the flywheel up to speed, wet your hands, and lean on the lump until it stops arguing."
    send room :wheel_on
  }

  open_it_up when (self.get(:stage) == "centred") {
    grammar "open it up"
    self.set(:stage, "open")
    say "Thumbs in the middle, down to a finger's width from the bat, and out."
  }

  pull_up_a_cup when (self.get(:stage) == "open") {
    grammar "pull up a cup"
    self.set(:stage, "cup")
    say "Two pulls and a third for luck. The wall comes up thin and the rim wobbles and then doesn't."
  }

  wire_it_off when (self.get(:stage) == "cup") {
    grammar "wire it off"
    self.set(:stage, "bare")
    actor.remember(:cups, 1)
    say "You draw the wire under it, let the wheel slow, and lift it off on its bat. Yours."
    send room :wheel_off
    send cup :thrown_again
  }
}
