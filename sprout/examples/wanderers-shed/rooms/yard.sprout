room yard {
  :name "The Yard"
  :smoke false
  prose "A square of cracked paving between the shed and the vegetable beds. A raku kiln — a dustbin lined with fibre, a gas burner underneath — sits on bricks in the middle. A bench against the shed wall, a rain barrel under the downpipe, and a robin on the handle of a fork that somebody left in the ground.\n\nThe shed door is open behind you. The glaze cupboard's hatch is propped in the end wall."

  describe {
    if (self.get(:smoke) == true) {
      text "The yard is full of smoke. The raku kiln roars on its bricks, the burner blue underneath, and the robin has gone to the far end of the beds to think about it. The bench, the barrel, the shed door open behind you; the hatch propped in the end wall."
    } else {
      text "A square of cracked paving between the shed and the vegetable beds. A raku kiln — a dustbin lined with fibre, a gas burner underneath — sits on bricks in the middle. A bench against the shed wall, a rain barrel under the downpipe, and a robin on the handle of a fork that somebody left in the ground.\n\nThe shed door is open behind you. The glaze cupboard's hatch is propped in the end wall."
    }
  }

  on :kiln_lit {
    self.set(:smoke, true)
  }

  on :kiln_out {
    self.set(:smoke, false)
  }

  exit "back into the shed" to shed
  exit "through the hatch to the glaze cupboard" to glaze
}
