object radio {
  :playing false
  :takeable false
  prose "A paint-spattered radio with a coat-hanger for an aerial."

  describe {
    if (self.get(:playing) == true) {
      text "The radio, playing. Something with trumpets, then a man reading the shipping forecast."
    } else {
      text "A paint-spattered radio with a coat-hanger for an aerial."
    }
  }

  switch_it_on when (self.get(:playing) == false) {
    grammar "switch it on"
    self.set(:playing, true)
    say "A click, a hiss, and then trumpets. The coat-hanger helps if you touch it."
    send room :radio_on
  }

  switch_it_off when (self.get(:playing) == true) {
    grammar "switch it off"
    self.set(:playing, false)
    say "Silence, and then the garden: a blackbird, someone's mower two fields over."
    send room :radio_off
  }

  twist_the_dial when (self.get(:playing) == true) {
    grammar "twist the dial"
    say "Static, a choir, static, a man very cross about roundabouts, static."
  }
}
