object book in shed {
  :name "Visitors' book"
  :takeable false
  :remembers [signed: false]
  prose "A hardback notebook, its cover swollen from damp, open at a page half full of names and small drawings of pots."

  describe {
    if (actor.recall(:signed) == true) {
      text "The visitors' book, open at a page with your own name at the bottom of it, and a small pot drawn beside it that you do not remember drawing."
    } else {
      text "A hardback notebook, its cover swollen from damp, open at a page half full of names and small drawings of pots."
    }
  }

  sign_the_book when (actor.recall(:signed) == false) {
    grammar "sign the book"
    actor.remember(:signed, true)
    say "You sign, and the pencil on its string swings back against the bench. The page is one name fuller."
  }

  read_the_last_page {
    grammar "read the last page"
    say "\"Came for a mug, left with a mug and three seedlings — A.\" \"Thank you for the tea. The cup leaks. I love it. — R.\""
  }
}
