room drying {
  :name "The Drying Room"
  :warm false
  :remembers [checked: false]
  prose "A narrow room lined floor to ceiling with slatted shelves, and on them ware in every state from glossy-wet to chalk-dry. A small heater sits unplugged on the floor. The air is still.\n\nThe corridor leads back to the front room; a door opens into the wheel room."

  describe {
    if (self.get(:warm) == true) {
      text "Warm and close; the heater ticks on the floor and the air is dry enough to feel on your lips. The shelves of ware seem to lean toward it. The corridor leads back to the front room; a door opens into the wheel room."
    } else {
      text "A narrow room lined floor to ceiling with slatted shelves, and on them ware in every state from glossy-wet to chalk-dry. A small heater sits unplugged on the floor. The air is still.\n\nThe corridor leads back to the front room; a door opens into the wheel room."
    }
  }

  on :heat_on {
    self.set(:warm, true)
  }

  on :heat_off {
    self.set(:warm, false)
  }

  exit "back down the corridor" to front
  exit "into the wheel room" to wheel
}
