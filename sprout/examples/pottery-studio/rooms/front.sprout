room front {
  :name "The Front Room"
  :steam false
  :remembers [welcomed: false]
  prose "A low room with a stone floor, swept but never clean of clay dust. Shelves of finished ware run along one wall — bowls, jugs, a row of cups with thumbprints in the handles. A bench under the window; a kettle on a ring by the door.\n\nDoors lead through to the wheel room and the clay store, and a corridor runs back to the drying room and the glazing room. A half-door opens onto the kiln yard, and past it, the courtyard."

  describe {
    if (self.get(:steam) == true && actor.recall(:welcomed) == true) {
      text "The room smells of tea and wet earth. The kettle mutters on its ring; you have been here before, and the place seems to know it.\n\nDoors lead through to the wheel room and the clay store, a corridor runs back to the drying room and the glazing room, a half-door opens onto the kiln yard, and past it, the courtyard."
    } else if (self.get(:steam) == true) {
      text "A low room with a stone floor, swept but never clean of clay dust. The kettle mutters on its ring and the windows have gone soft with steam. Shelves of finished ware run along one wall.\n\nDoors lead through to the wheel room and the clay store, a corridor runs back to the drying room and the glazing room, a half-door opens onto the kiln yard, and past it, the courtyard."
    } else {
      text "A low room with a stone floor, swept but never clean of clay dust. Shelves of finished ware run along one wall — bowls, jugs, a row of cups with thumbprints in the handles. A bench under the window; a kettle on a ring by the door.\n\nDoors lead through to the wheel room and the clay store, and a corridor runs back to the drying room and the glazing room. A half-door opens onto the kiln yard, and past it, the courtyard."
    }
  }

  look_around {
    grammar "look around"
    actor.remember(:welcomed, true)
    say "Someone has pinned a note by the door: \"Back in ten. Put the kettle on. Do not touch the kiln unless you mean it.\" — M."
  }

  on :kettle_on {
    self.set(:steam, true)
  }

  on :kettle_off {
    self.set(:steam, false)
  }

  exit "through to the wheel room" to wheel
  exit "into the clay store" to clay
  exit "down the corridor to the drying room" to drying
  exit "along to the glazing room" to glaze
  exit "out to the kiln yard" to kiln
  exit "out into the courtyard" to courtyard
}
