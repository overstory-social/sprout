room glaze {
  :name "The Glazing Room"
  :remembers [favourite: one_of [none, celadon, tenmoku, shino] default none]
  prose "A bright room with a big sink and a row of lidded buckets along the bench: celadon, tenmoku, shino, each labelled in marker. A board of test tiles hangs on the wall like a colour chart.\n\nThe front room is back along the corridor; a door opens straight onto the kiln yard."

  describe {
    if (actor.recall(:favourite) == "celadon") {
      text "A bright room with a big sink and a row of lidded buckets along the bench. The celadon bucket has been pulled forward; it is the one you keep coming back to. The front room is back along the corridor; a door opens onto the kiln yard."
    } else if (actor.recall(:favourite) == "tenmoku") {
      text "A bright room with a big sink and a row of lidded buckets along the bench. The tenmoku bucket has been pulled forward; it is the one you keep coming back to. The front room is back along the corridor; a door opens onto the kiln yard."
    } else if (actor.recall(:favourite) == "shino") {
      text "A bright room with a big sink and a row of lidded buckets along the bench. The shino bucket has been pulled forward; it is the one you keep coming back to. The front room is back along the corridor; a door opens onto the kiln yard."
    } else {
      text "A bright room with a big sink and a row of lidded buckets along the bench: celadon, tenmoku, shino, each labelled in marker. A board of test tiles hangs on the wall like a colour chart.\n\nThe front room is back along the corridor; a door opens straight onto the kiln yard."
    }
  }

  choose_celadon {
    grammar "choose celadon"
    actor.remember(:favourite, "celadon")
    say "Celadon: a green like a pond in shade. You pull the bucket forward."
  }

  choose_tenmoku {
    grammar "choose tenmoku"
    actor.remember(:favourite, "tenmoku")
    say "Tenmoku: black-brown breaking to rust on the rims. You pull the bucket forward."
  }

  choose_shino {
    grammar "choose shino"
    actor.remember(:favourite, "shino")
    say "Shino: chalk-white, crawling, orange where it thins. You pull the bucket forward."
  }

  exit "back down the corridor" to front
  exit "out to the kiln yard" to kiln
}
