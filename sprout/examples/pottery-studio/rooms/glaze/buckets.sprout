object buckets {
  :name "Glaze buckets"
  :stirred false
  :takeable false
  prose "Three lidded buckets, their glazes settled to a hard layer under an inch of water."

  describe {
    if (self.get(:stirred) == true) {
      text "Three lidded buckets, stirred to a cream: celadon, tenmoku, shino, ready to dip."
    } else {
      text "Three lidded buckets, their glazes settled to a hard layer under an inch of water."
    }
  }

  stir_the_buckets when (self.get(:stirred) == false) {
    grammar "stir the buckets"
    self.set(:stirred, true)
    say "You stir each one with a paddle until the sludge lifts and the glaze goes creamy. Your arm aches."
  }

  let_them_settle when (self.get(:stirred) == true) {
    grammar "let them settle"
    self.set(:stirred, false)
    say "You put the lids back. By tomorrow they will have settled again."
  }
}
