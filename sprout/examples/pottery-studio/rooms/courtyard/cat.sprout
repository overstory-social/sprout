object cat in courtyard {
  :name "The studio cat"
  :mood one_of [asleep, awake, gone] default asleep
  :takeable false
  :remembers [befriended: false]
  prose "A grey cat, asleep on the warm stones, with clay on one paw."

  describe {
    if (self.get(:mood) == "awake") {
      text "The grey cat sits up and watches you with the patience of something that owns the place."
    } else if (self.get(:mood) == "gone") {
      text "The cat has gone over the wall. There is a warm place on the stones where it was."
    } else {
      text "A grey cat, asleep on the warm stones, with clay on one paw."
    }
  }

  stroke_the_cat when (self.get(:mood) == "asleep") {
    grammar "stroke the cat"
    self.set(:mood, "awake")
    say "One ear turns, then the cat sits up and looks at you sideways."
  }

  offer_it_a_scrap when (self.get(:mood) == "awake" && actor.recall(:befriended) == false) {
    grammar "offer it a scrap"
    actor.remember(:befriended, true)
    say "The cat takes it, and leans, briefly, against your shin. You are known now."
  }

  startle_it when (self.get(:mood) != "gone") {
    grammar "startle it"
    self.set(:mood, "gone")
    say "The cat is over the wall before you have finished moving."
  }

  wait_for_the_cat when (self.get(:mood) == "gone") {
    grammar "wait for the cat"
    self.set(:mood, "asleep")
    say "Eventually it comes back over the wall, and settles, and sleeps."
  }
}
