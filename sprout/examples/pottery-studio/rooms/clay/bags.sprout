object bags {
  :name "Bags of clay"
  :bags 12 min 0 max 20
  :takeable false
  prose "Stoneware, twelve and a half kilos a bag, stacked five high."

  describe {
    if (self.get(:bags) == 0) {
      text "The stack is gone; a few scraps of plastic and a damp patch mark where it stood."
    } else if (self.get(:bags) < 5) {
      text "Only a few bags left, leaning against each other."
    } else {
      text "Stoneware, twelve and a half kilos a bag, stacked five high."
    }
  }

  take_a_bag when (self.get(:bags) > 0) {
    grammar "take a bag"
    self.adjust(:bags, -1)
    say "Twelve and a half kilos of cold clay. Your arms know it."
  }

  unload_the_delivery when (self.get(:bags) < 5) {
    grammar "unload the delivery"
    self.adjust(:bags, 10)
    say "The van has been. You stack the new bags five high, sweating."
  }
}
