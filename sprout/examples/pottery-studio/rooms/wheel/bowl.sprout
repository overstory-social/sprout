object bowl {
  :name "Wet bowl"
  :state one_of [wet, leather, bone_dry, bisqued, glazed, fired] default wet
  :takeable true
  prose "A freshly thrown bowl on a plaster bat, grey and glossy and soft as cheese."

  describe {
    if (self.get(:state) == "leather") {
      text "A bowl gone leather-hard: cool, matte, and firm enough to trim."
    } else if (self.get(:state) == "bone_dry") {
      text "A bone-dry bowl, pale and chalky, light as paper and twice as fragile."
    } else if (self.get(:state) == "bisqued") {
      text "A bisque-fired bowl, pink-white and porous, ringing faintly when tapped."
    } else if (self.get(:state) == "glazed") {
      text "A bowl dipped in celadon glaze, chalky green, waiting for the kiln."
    } else if (self.get(:state) == "fired") {
      text "A finished bowl, celadon over a signed foot ring, glossy as a pond."
    } else {
      text "A freshly thrown bowl on a plaster bat, grey and glossy and soft as cheese."
    }
  }

  leave_it_to_stiffen when (self.get(:state) == "wet") {
    grammar "leave it to stiffen"
    self.set(:state, "leather")
    say "You turn it in the air a while. It stiffens to leather-hard."
  }

  trim_the_foot when (self.get(:state) == "leather") {
    grammar "trim the foot"
    say "Ribbons of clay curl off the foot. You sign it with a small letter of your own."
  }

  let_it_dry_right_through when (self.get(:state) == "leather") {
    grammar "let it dry right through"
    self.set(:state, "bone_dry")
    say "Days pass in a minute. It is bone dry, and ready for the kiln."
  }

  dip_it_in_glaze when (self.get(:state) == "bisqued") {
    grammar "dip it in glaze"
    self.set(:state, "glazed")
    say "In and out of the celadon bucket in one smooth motion. Wipe the foot."
  }

  on :fired {
    if (self.get(:state) == "bone_dry") {
      self.set(:state, "bisqued")
      say "The bowl comes out of the kiln bisqued, pink and porous."
    } else if (self.get(:state) == "glazed") {
      self.set(:state, "fired")
      say "The bowl comes out finished: the celadon has gone glossy and deep."
    } else {
      say "The bowl was not ready for that firing; it comes out as it went in."
    }
  }

  on :thrown_again {
    self.set(:state, "wet")
  }
}
