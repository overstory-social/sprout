object shelves in drying {
  :name "Drying shelves"
  :takeable false
  :remembers [checked: false]
  prose "Slatted pine shelves, bowed in the middle, holding a hundred things half made."

  describe {
    if (actor.recall(:checked) == true) {
      text "Slatted pine shelves. You have already turned everything once today."
    } else {
      text "Slatted pine shelves, bowed in the middle, holding a hundred things half made."
    }
  }

  turn_the_ware when (actor.recall(:checked) == false) {
    grammar "turn the ware"
    actor.remember(:checked, true)
    say "You go along the shelves turning each piece so it dries even. It takes a while."
  }
}
