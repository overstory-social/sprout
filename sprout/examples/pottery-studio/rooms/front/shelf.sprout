object shelf {
  :name "Shelf of finished ware"
  :bowls 7 min 0 max 12
  :takeable false
  prose "Bowls, jugs and cups, glazed celadon and tenmoku and a chalky shino."

  describe {
    if (self.get(:bowls) == 0) {
      text "The shelf is bare but for a ring of dust where each bowl stood."
    } else if (self.get(:bowls) == 12) {
      text "The shelf is full to the ends; one more and something falls."
    } else {
      text "Bowls, jugs and cups, glazed celadon and tenmoku and a chalky shino."
    }
  }

  take_a_bowl_down when (self.get(:bowls) > 0) {
    grammar "take a bowl down"
    self.adjust(:bowls, -1)
    say "You lift a bowl down and turn it over. The foot ring is signed with a small M."
  }

  put_a_bowl_back when (self.get(:bowls) < 12) {
    grammar "put a bowl back"
    self.adjust(:bowls, 1)
    say "You slide a bowl back into its ring of dust."
  }
}
