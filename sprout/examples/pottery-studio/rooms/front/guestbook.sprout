object guestbook {
  :name "Guest book"
  :takeable false
  :remembers [signed: false]
  prose "A fat, clay-smudged notebook on a string. Most of the names are potters."

  describe {
    if (actor.recall(:signed) == true) {
      text "A fat, clay-smudged notebook on a string. Your name is on the last line."
    } else {
      text "A fat, clay-smudged notebook on a string. Most of the names are potters."
    }
  }

  sign_the_book when (actor.recall(:signed) == false) {
    grammar "sign the book"
    actor.remember(:signed, true)
    say "You write your name on a fresh line, under a drawing of a cat."
  }
}
