room clay {
  :name "The Clay Store"
  :grinding false
  prose "Cool and dim, smelling of wet earth. Bags of clay are stacked against the wall in plastic that sweats in the cold. A pug mill squats in the corner; a scale hangs from a beam.\n\nThe front room is back through the door."

  describe {
    if (self.get(:grinding) == true) {
      text "The pug mill grinds and thumps in the corner, extruding a fat grey worm of clay onto the bench. The whole room shakes a little with it. The front room is back through the door."
    } else {
      text "Cool and dim, smelling of wet earth. Bags of clay are stacked against the wall in plastic that sweats in the cold. A pug mill squats in the corner; a scale hangs from a beam.\n\nThe front room is back through the door."
    }
  }

  breathe_in {
    grammar "breathe in"
    say "Wet earth, cold stone, and a little diesel from the pug mill."
  }

  on :mill_on {
    self.set(:grinding, true)
  }

  on :mill_off {
    self.set(:grinding, false)
  }

  exit "back to the front room" to front
}
