object kiln {
  :name "The kiln"
  :door one_of [open, closed] default closed
  :temp 0 min 0 max 1300
  :takeable false
  :remembers [fired_once: false]
  prose "A whitewashed wood kiln with an iron door, cold, its firebox swept."

  describe {
    if (self.get(:door) == "closed" && self.get(:temp) == 0 && actor.recall(:fired_once) == true) {
      text "A whitewashed wood kiln with an iron door, cold again. You have fired it once; the yard remembers, and so do your arms."
    } else if (self.get(:door) == "open") {
      text "The kiln door stands open on a dark chamber of shelves and props. It is cold inside."
    } else if (self.get(:door) == "closed" && self.get(:temp) > 1000) {
      text "The kiln door is shut and glowing at the seams; the spy hole shows orange-white. Cone ten is not far off."
    } else if (self.get(:door) == "closed" && self.get(:temp) > 0) {
      text "The kiln door is shut; the firebox crackles, and the brick is warm to the hand."
    } else {
      text "A whitewashed wood kiln with an iron door, cold, its firebox swept."
    }
  }

  open_the_door when (self.get(:door) == "closed" && self.get(:temp) <= 100) {
    grammar "open the door"
    self.set(:door, "open")
    say "Cold enough. You unbolt the door and swing it open on the dark chamber."
  }

  close_the_door when (self.get(:door) == "open") {
    grammar "close the door"
    self.set(:door, "closed")
    say "You swing the door to and drop the bolt. Anything in your hands is in there with the shelves."
  }

  light_the_firebox when (self.get(:door) == "closed" && self.get(:temp) == 0) {
    grammar "light the firebox"
    self.set(:temp, 250)
    say "Kindling, then splits. Smoke, then a roar. You will be here a while."
    send room :kiln_lit
  }

  stoke_the_fire when (self.get(:door) == "closed" && self.get(:temp) > 0 && self.get(:temp) < 1300) {
    grammar "stoke the fire"
    self.adjust(:temp, 350)
    if (self.get(:temp) <= 1299) {
      say "An armful of splits into the firebox. The roar climbs half a note."
    } else {
      say "Cone ten bends over like a tired man. That is the firing done. Now the long wait."
      actor.remember(:fired_once, true)
      broadcast :fired
    }
  }

  let_it_cool when (self.get(:door) == "closed" && self.get(:temp) > 0) {
    grammar "let it cool"
    self.set(:temp, 0)
    say "A day and a night pass in a minute. The brick ticks as it cools."
    send room :kiln_cold
  }
}
