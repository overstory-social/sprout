room courtyard {
  :name "The Courtyard"
  :remembers [befriended: false]
  prose "A square of flagstones with a fig tree in one corner and a tap in another, dripping onto a bucket. A bench in the sun. The studio cat is asleep on the warm stones.\n\nThe front room is through the door; the kiln yard is through the gate."

  describe {
    if (actor.recall(:befriended) == true) {
      text "A square of flagstones with a fig tree and a dripping tap. The studio cat looks up when you come in, and decides you will do. The front room is through the door; the kiln yard is through the gate."
    } else {
      text "A square of flagstones with a fig tree in one corner and a tap in another, dripping onto a bucket. A bench in the sun. The studio cat is asleep on the warm stones.\n\nThe front room is through the door; the kiln yard is through the gate."
    }
  }

  exit "in through the door to the front room" to front
  exit "through the gate to the kiln yard" to kiln
}
