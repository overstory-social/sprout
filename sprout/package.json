{
  "name": "@overstory/sprout",
  "version": "0.1.0",
  "description": "Sprout — a small, total, deterministic language for interactive rooms and objects, with its runtime, two stores and its first extension. The language is `./lang`; the runtime `./core`; the stores `./store-sql` and `./store-document`; pictures `./ext-media`; the example microworlds `./examples`.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overstory-social/sprout.git",
    "directory": "sprout"
  },
  "homepage": "https://github.com/overstory-social/sprout#readme",
  "bugs": "https://github.com/overstory-social/sprout/issues",
  "keywords": ["sprout", "interactive-fiction", "microworld", "language", "mud"],
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./lang/dist/index.d.ts", "default": "./lang/dist/index.js" },
    "./lang": { "types": "./lang/dist/index.d.ts", "default": "./lang/dist/index.js" },
    "./core": { "types": "./core/dist/index.d.ts", "default": "./core/dist/index.js" },
    "./conformance": { "types": "./core/dist/conformance.d.ts", "default": "./core/dist/conformance.js" },
    "./testing": { "types": "./core/dist/testing.d.ts", "default": "./core/dist/testing.js" },
    "./store-sql": { "types": "./store-sql/dist/index.d.ts", "default": "./store-sql/dist/index.js" },
    "./store-document": { "types": "./store-document/dist/index.d.ts", "default": "./store-document/dist/index.js" },
    "./ext-media": { "types": "./ext-media/dist/index.d.ts", "default": "./ext-media/dist/index.js" },
    "./examples": { "types": "./examples/dist/index.d.ts", "default": "./examples/dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lang/dist",
    "lang/README.md",
    "core/dist",
    "core/README.md",
    "store-sql/dist",
    "store-sql/README.md",
    "store-document/dist",
    "store-document/README.md",
    "ext-media/dist",
    "ext-media/README.md",
    "examples/dist",
    "examples/pottery-studio",
    "examples/wanderers-shed",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run",
    "typecheck:spec": "for d in lang core ext-media store-sql store-document examples; do tsc -p $d/tsconfig.spec.json --noEmit || exit 1; done"
  },
  "dependencies": {
    "zod": "^4.4.2"
  }
}
