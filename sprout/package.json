{
  "name": "@overstory/sprout",
  "version": "0.1.0",
  "description": "Sprout \u2014 a small, total, deterministic language for multiplayer interactive-fiction worlds, with its runtime and two stores. The language is `./lang`; the runtime's store port `./core`; the stores `./store-sql` and `./store-document`.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overstory-social/sprout.git",
    "directory": "sprout"
  },
  "homepage": "https://github.com/overstory-social/sprout#readme",
  "bugs": "https://github.com/overstory-social/sprout/issues",
  "keywords": [
    "sprout",
    "interactive-fiction",
    "microworld",
    "language",
    "mud"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./lang/dist/index.d.ts",
      "default": "./lang/dist/index.js"
    },
    "./lang": {
      "types": "./lang/dist/index.d.ts",
      "default": "./lang/dist/index.js"
    },
    "./core": {
      "types": "./core/dist/index.d.ts",
      "default": "./core/dist/index.js"
    },
    "./conformance": {
      "types": "./core/dist/conformance.d.ts",
      "default": "./core/dist/conformance.js"
    },
    "./store-sql": {
      "types": "./store-sql/dist/index.d.ts",
      "default": "./store-sql/dist/index.js"
    },
    "./store-document": {
      "types": "./store-document/dist/index.d.ts",
      "default": "./store-document/dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lang/dist",
    "lang/README.md",
    "core/dist",
    "core/README.md",
    "store-sql/dist",
    "store-sql/README.md",
    "store-document/dist",
    "store-document/README.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "vitest run",
    "typecheck:spec": "for d in lang core store-sql store-document; do tsc -p $d/tsconfig.spec.json --noEmit || exit 1; done"
  },
  "dependencies": {
    "zod": "^4.4.2"
  }
}
