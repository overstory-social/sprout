{
  "name": "@overstory/sprout-ext-media",
  "version": "0.1.0",
  "description": "Pictures for Sprout: the `media` value type, the `:image` well-known property and the `show` statement, as a language extension.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "build:watch": "tsc -p . --watch",
    "test": "vitest run",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@overstory/sprout": "*",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.0.8"
  }
}
