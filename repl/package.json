{
  "name": "@overstory/sprout-repl",
  "version": "0.1.0",
  "description": "Sprout's REPL: a microworld you are working on, played interactively one typed line at a time.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/io.d.ts",
      "default": "./dist/fixtures/io.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "build:watch": "tsc -p . --watch",
    "test": "vitest run",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@overstory/sprout": "0.1.0",
    "@overstory/sprout-player": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overstory-social/sprout.git",
    "directory": "repl"
  },
  "engines": {
    "node": ">=22"
  }
}
