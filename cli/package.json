{
  "name": "@overstory/sprout-cli",
  "version": "0.1.0",
  "description": "The Sprout command line: init, check, parse, view and skill on a microworld folder; play and test through the player and the REPL; and, where they are installed, the terminal client and the server.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sprout": "bin/sprout.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "build:watch": "tsc -p . --watch",
    "test": "vitest run",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@overstory/sprout": "0.1.0",
    "@overstory/sprout-player": "0.1.0",
    "@overstory/sprout-repl": "0.1.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@overstory/sprout-mcp": "0.1.0",
    "@overstory/sprout-server": "0.1.0",
    "@overstory/sprout-tui": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overstory-social/sprout.git",
    "directory": "cli"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@overstory/sprout-mcp": "0.1.0",
    "@overstory/sprout-server": "0.1.0",
    "@overstory/sprout-tui": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@overstory/sprout-mcp": {
      "optional": true
    },
    "@overstory/sprout-server": {
      "optional": true
    },
    "@overstory/sprout-tui": {
      "optional": true
    }
  }
}
