// The `.prose` file a describe's every `text` names is not here, so
// the description would say nothing.
import * as sprout from 'sprout'
import {Person} from 'person'
import {Mirror} from 'mirror'

world describe_prose_gone is sprout.World {
  visitors are Person
  visitors arrive at hall

  object hall is sprout.Place {
    object mirror is Mirror
  }
}
