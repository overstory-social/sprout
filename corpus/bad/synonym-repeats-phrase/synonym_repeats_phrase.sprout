import * as sprout from 'sprout'
import {Person} from 'person'
import {pry} from 'pry'

world synonym_repeats_phrase is sprout.World {
  visitors are Person
  visitors arrive at yard

  // `prise` gives `pry` a phrase its own synonym gave it.
  synonyms pry: "prise", "lever"

  object yard is sprout.Place {
    // `lever` gives it one the world's gave it; `force` is the chest's own.
    object chest is sprout.Fixture { synonyms pry: "lever", "force" }
  }
}
