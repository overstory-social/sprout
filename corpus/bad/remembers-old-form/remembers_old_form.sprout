// Memory written as a list, with a colon before `remembers`, is refused,
// and the remedy is the block its entries make.
import * as sprout from 'sprout'
import {Creature} from 'creature'

world remembers_old_form is sprout.World {
  visitors are Creature
  visitors arrive at hall

  object hall is sprout.Place {
    :remembers [handled: false, visits: 0 min 0 max 99]
  }
}
