// A stray `]` inside a list-of-lists default must not silently drop
// what is written after it.
enum Ward { oak, silver, brass, tin }

world list_default_stray_closer is sprout.World {
  visitors are Creature
  visitors arrive at hall
  :grid [[Ward]] default [[oak, silver, ]], [brass, tin]]
}

kind Creature is sprout.Visitor { }
