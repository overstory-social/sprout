import * as sprout from 'sprout'
import {Creature} from 'creature'
import {Room} from 'room'
import {Thing} from 'thing'

world container_holds_nothing is sprout.World {
  visitors are Creature
  visitors arrive at hall

  object hall is Room {
    // A thing can only be in something that holds things.
    object bench is Thing {
      object cushion is Thing
    }
  }
}
