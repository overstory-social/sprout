// `seen` is a reserved word, since it is what a `describe` binds, so it
// names nothing else, a role of a verb no describe reads included.
import * as sprout from 'sprout'
import {Person} from 'person'
import {Lamp} from 'lamp'

world seen_reserved is sprout.World {
  visitors are Person
  visitors arrive at hall

  object hall is sprout.Place {
    object lamp is Lamp
  }
}
