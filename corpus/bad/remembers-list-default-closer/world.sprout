// A colonless entry right after a list-default entry must not carry the
// `]` that closes `:remembers` off with it.
enum Ward { oak, silver }

world remembers_list_default_closer is sprout.World {
  visitors are Creature
  visitors arrive at hall
  :remembers [echo: [oak], faulty "x"]
  :greeting "hello"
}

kind Creature is sprout.Actor { }
