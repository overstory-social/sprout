// A wardrobe holds actors without composing `sprout.Place`, so it could be
// someone's place, and `here` is not known to be a `sprout.Place`: the
// lamp's walk and count of it are refused, naming the wardrobe.
world here_not_a_place is sprout.World {
  visitors are Person
  visitors arrive at hall

  object hall is sprout.Place {
    object lamp is Lamp
    object wardrobe is Wardrobe
  }
}

verb light { role target  "light [target]" }
