world act_filler_wrong_kind is sprout.World {
  contains actors
  visitors are Person
  visitors arrive at hall

  object hall is sprout.Place
}

kind Creature is sprout.Actor { }
kind Person is Creature, sprout.Visitor { }

verb pet    { role target  "pet [target]" }
verb unlock { role target: Lockable  role tool  "unlock [target] with [tool]"  "unlock [target]" }
