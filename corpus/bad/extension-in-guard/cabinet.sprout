// An extension's statement records an effect, and a guard and a `permit`
// only read and decide: neither may hold one, on any host.
import {open} from 'sprout'

extension gallery 1

kind Cabinet {
  contains
  grammar { name "cabinet"  nouns "cabinet" }
  accept (item, from) {
    gallery.show("drawer.png", "a drawer sliding open")
    allow
  }
  as target for open {
    permit {
      gallery.show("cabinet.png", "the cabinet")
      allow
    }
    do { say "The doors swing open." }
  }
}
