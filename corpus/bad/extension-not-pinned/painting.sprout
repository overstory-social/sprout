// A file names only an extension the manifest pins: the manifest is what
// a host reads to know what the world needs before a line of it is read.
import {view} from 'extension_not_pinned'

extension gallery 1

kind Painting {
  grammar { name "painting"  nouns "painting" }
  as target for view {
    do {
      gallery.show("cat.png", "a cat")
      say "You look closely."
    }
  }
}
