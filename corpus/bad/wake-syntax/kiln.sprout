// A wake says `in`, how long as a whole number written out or worked
// out in brackets, and `seconds`, `minutes` or `hours`, always plural.
import {:stir} from 'wake_syntax'

kind Kiln {
  :delay 3 min 0 max 9

  on :stir {
    wake 3 hours
    wake in 1 hour
    wake in 3
    wake in self.get(:delay) minutes
    wake in 2 days
  }
}
