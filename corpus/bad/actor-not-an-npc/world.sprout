world actor_not_an_npc is sprout.World {
  visitors are Creature
  visitors arrive at hall

  object hall is sprout.Place {
    object porter is Porter
  }
}

kind Creature is sprout.Actor { }

// A porter is an actor, but it is not made of what visitors are made of,
// so it is neither a visitor nor an NPC, and the only actors are those.
kind Porter is sprout.Actor { }
