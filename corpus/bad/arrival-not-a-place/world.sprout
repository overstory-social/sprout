// Visitors arrive in a place: something that holds actors. A bench
// holds things, and not people.
world arrival_not_a_place is sprout.World {
  visitors are Creature
  visitors arrive at hall.bench

  object hall is Room {
    object bench is Bench
  }
}

kind Room {
  contains actors
}

kind Bench {
  contains
}

kind Creature is sprout.Actor { }
