world act_leaves_out_tool: sprout.World {
  contains actors
  visitors are Visitor
  visitors arrive at hall
}

kind Visitor: sprout.Actor { }

verb pet    { role target  "pet [target]" }
verb shove  { role target  role pole  "shove [target] with [pole]" }
verb poke   { role target  role tool }

object hall: sprout.Place in act_leaves_out_tool
