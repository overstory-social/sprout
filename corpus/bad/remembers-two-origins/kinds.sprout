// `:remembers` entries merge by the same rule as properties: two kinds
// remembering `:seen` are two claims on one slot.
kind Watched {
  :remembers [seen: false]
}

kind Greeted {
  :remembers [seen: false]
}

object bell: Watched, Greeted in composing_room

// Where the objects above sit.
kind Room {
  contains actors
}

object composing_room: Room in remembers_two_origins
