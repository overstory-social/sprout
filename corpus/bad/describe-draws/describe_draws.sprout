// A describe draws nothing, in itself or in a passage it says: it runs
// whenever anyone looks, and a roll would change the thing while
// nobody acts.
import * as sprout from 'sprout'
import {Person} from 'person'
import {Lamp} from 'lamp'

world describe_draws is sprout.World {
  visitors are Person
  visitors arrive at hall

  object hall is sprout.Place {
    object lamp is Lamp
  }
}
