// Neither `Creature` nor `Porter` composes the other, so neither
// restatement supersedes the other, and a person made of both has two
// claims on one slot: it has to say which it holds.
import * as sprout from 'sprout'
import {Creature} from 'creature'
import {Porter} from 'porter'

kind Person is Creature, Porter, sprout.Visitor { }
