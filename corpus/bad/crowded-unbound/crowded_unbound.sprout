// The engine says the world's `crowded` with `{item}` and `{to}` alone.
import * as sprout from 'sprout'
import {Person} from 'person'

world crowded_unbound is sprout.World {
  visitors are Person
  visitors arrive at yard

  passage crowded { {actor} cannot fit in {to}. }

  object yard is sprout.Place
}
