// A role a thing fills takes one thing: neither a set nor a value.
import {Creature} from 'creature'
import {play, nuzzle} from 'act_filler_mismatch'

kind Cat is Creature {
  :naps 0 min 0 max 9

  as target for play {
    do {
      let naps = self.get(:naps)
      act nuzzle (target: toys)
      act nuzzle (target: naps)
    }
  }
}
