world kind_contents_loop is sprout.World {
  visitors are Creature
  visitors arrive at composing_room

  object composing_room is sprout.Place {
    object box is Box
    object lantern is Lantern
  }
}

kind Creature is sprout.Visitor { }

// A box that holds a box would hold another inside that, without end.
kind Box {
  contains
  object inner is Box
}

// So would a lantern whose wick holds a lantern, through two kinds.
kind Lantern {
  contains
  object wick is Wick
}

kind Wick {
  contains
  object spare is Lantern
}
