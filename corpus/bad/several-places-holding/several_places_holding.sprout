// A thing in more than one place holds nothing, since what it held would be
// in every one of them at once, and it takes a name no other thing there
// has (the spec's The world model › One thing in several places).
import * as sprout from 'sprout'
import {Person} from 'person'

world several_places_holding is sprout.World {
  visitors are Person
  visitors arrive at hall

  object hall is sprout.Place { }
  object yard is sprout.Place {
    object gate is Bell
  }
}

object keyhole is sprout.Container in hall, yard
object gate is Bell in hall, yard

kind Bell { }
