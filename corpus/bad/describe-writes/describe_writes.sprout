// A describe only reads: it runs whenever anyone looks, so it writes,
// moves, spawns, sends and destroys nothing.
import * as sprout from 'sprout'
import {Person} from 'person'
import {Lamp} from 'lamp'

world describe_writes is sprout.World {
  visitors are Person
  visitors arrive at hall

  object hall is sprout.Place {
    object lamp is Lamp
  }
}
message :looked
