    do {
      say "It gives."
      tell "{actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever. {actor} leans on the lever."
    }
  }
}
