import * as sprout from 'sprout'

// The hall reads the cellar, another place, and not the one its way north
// leads to: the world lets nothing pass between its places, so neither
// read could ever be made.
world other_place_read is sprout.World {
  visitors are Person
  visitors arrive at hall

  object hall is sprout.Place {
    grammar { exit north "north" -> yard when (cellar.get(:dry)) }
    describe { text "A hall.{if other_place_read.yard.is(sprout.Place)} The yard is north.{/if}" }
  }
  object yard is sprout.Place {
    grammar { exit south "south" -> hall }
  }
  object cellar is sprout.Place {
    :dry true
  }
}

kind Person is sprout.Visitor { }
