// A link is its name, a word of the author's in lower case, then its
// label in quotes; each line written wrong is refused once, and the good
// line after it is kept.
world link_lines is sprout.World {
  visitors are Person
  visitors arrive at yard

  object yard is sprout.Place {
    grammar {
      link "the way on"
      link Onward "the way on"
      link back
      link onward "the way on"
    }
  }
}
