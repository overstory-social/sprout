world spawn_actor_not_an_npc is sprout.World {
  visitors are Creature
  visitors arrive at hall

  object hall is sprout.Place {
    object bell is Bell
  }
}

kind Creature is sprout.Actor { }

kind Porter is sprout.Actor { }

verb ring { role target  "ring [target]" }

// What a spawn makes is declared nowhere, and an actor made that way is
// an NPC like any other, so it is made of what visitors are made of.
kind Bell {
  as target for ring {
    do { spawn Porter in here }
  }
}
