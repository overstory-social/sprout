world move_world is sprout.World {
  contains actors
  visitors are Visitor
  visitors arrive at hall

  // The world is the root of the tree, and goes nowhere.
  as tool for shake {
    do { move self to target }
  }

  object hall is sprout.Place
}

kind Visitor is sprout.Actor { }

verb shake { role target  role tool  "shake [target] with [tool]" }
