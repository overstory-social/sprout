// A library's version is semver, as the world's is. The corpus can vendor
// only the standard library, so the library pinned here does not travel
// either, and the page says both.
import * as sprout from 'sprout'
import {Creature} from 'creature'
import {Hall} from 'hall'

world library_version_not_semver is sprout.World {
  visitors are Creature
  visitors arrive at hall

  object hall is Hall
}
