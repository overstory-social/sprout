// `connect` names a link by its name, so one body writes one link of
// each name.
import * as sprout from 'sprout'
import {Person} from 'person'

world link_twice is sprout.World {
  visitors are Person
  visitors arrive at yard

  object yard is sprout.Place {
    grammar {
      link onward "deeper into the dark"
      link onward "further on"
    }
  }
}
