{
  "about": "`all` takes everything in reach a role may take, each in turn, and `except` leaves things out.",
  "steps": [
    { "arrive": "Marta", "expect": [
      { "reader": "Marta", "kind": "described", "words": "There is nothing special about the cellar." }
    ] },
    { "as": "Marta", "type": "take all", "expect": [
      { "level": "info", "text": "step: sprout.take" },
      { "reader": "Marta", "kind": "said", "words": "You take a key." },
      { "level": "info", "text": "step: sprout.take" },
      { "reader": "Marta", "kind": "said", "words": "You take a coin." }
    ] },
    { "as": "Marta", "type": "drop all except the coin", "expect": [
      { "reader": "Marta", "kind": "said", "words": "You put a key down." }
    ] },
    { "as": "Marta", "type": "take all except key", "expect": [
      { "reader": "Marta", "kind": "refused", "words": "You already have it." }
    ] },
    { "as": "Marta", "type": "drop all", "expect": [
      { "level": "info", "text": "step: sprout.drop" },
      { "reader": "Marta", "kind": "said", "words": "You put a coin down." },
      { "level": "info", "text": "step: sprout.drop" },
      { "reader": "Marta", "kind": "refused", "words": "You are not holding a key." }
    ] },
    { "as": "Marta", "type": "take all", "expect": [
      { "level": "info", "text": "step: sprout.take" },
      { "reader": "Marta", "kind": "said", "words": "You take a key." },
      { "level": "info", "text": "step: sprout.take" },
      { "reader": "Marta", "kind": "said", "words": "You take a coin." }
    ] }
  ]
}
