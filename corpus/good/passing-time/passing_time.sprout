// Waiting that passes time (the spec's Time › Passing time). At the bottom
// of a dry well, `wait` lets a minute and a half pass, as Zork's three
// moves did; waiting for the bucket lets up to an hour pass; and sleeping
// asks for three hours, more than the host's longest pass, so only an hour
// passes. A wake that falls due while someone waits arrives while they
// wait, and one that does not waits for the time that follows.
import * as sprout from 'sprout'
import {Person} from 'person'
import {Bucket} from 'bucket'
import {Hourglass} from 'hourglass'

world passing_time is sprout.World {
  visitors are Person
  visitors arrive at well_bottom

  object well_bottom is sprout.Place {
    describe { text "The bottom of a dry well. A rope runs up out of sight." }
    object bucket is Bucket
    object hourglass is Hourglass
  }
}

verb hoist { role target  "hoist [target]" }
verb await { role target  "wait for [target]" }
verb tip   { role target  "tip [target]" }
verb sleep { "sleep" }
