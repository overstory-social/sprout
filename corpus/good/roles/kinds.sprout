enum Topic { bridge, toll, weather }

// A `permit` decides and a `do` acts.
kind Lever {
  :pulled false

  passage clunk { The lever drops with a clunk. }

  as target for pull {
    permit { if (self.get(:pulled)) { refuse "It is already down." } }
    do     { self.set(:pulled, true)  say clunk }
  }
}

// The ordinary refusal, which a lock of any kind carries.
kind Lockable {
  :locked true

  as target for unlock {
    permit { if (!self.get(:locked)) { refuse "It is already unlocked." } }
    do     { self.set(:locked, false)  say "The lock turns over." }
  }
}

// A second player of the same role: `Lockable`'s `permit` runs, then this
// one, and either may refuse. The tool is read only once `bound` says a
// visitor named one.
kind Warded is Lockable {
  :sealed false

  as target for unlock {
    permit {
      if (self.get(:sealed)) { refuse "A second ward shimmers across the plate." }
      else if (bound tool) {
        if (!tool.is(Key)) { refuse "{tool} is not a key." }
      } else {
        refuse "You need something to turn the lock with."
      }
    }
  }
}

// A lock rusted open at the plate: `Lockable`'s refusal and bolt are left
// out, and `Warded`'s ward still runs.
kind Rusted is Warded {
  without as target for unlock from Lockable
}

kind Key {
  :wear 0 min 0 max 99

  as tool for unlock {
    permit { if (self.get(:wear) >= 99) { refuse "The bit is worn smooth. It turns nothing." } }
    do     { self.adjust(:wear, 1) }
  }
}

// The standard library's `ask`, whose topic this guard narrows to what it
// knows; anything else a visitor names arrives unbound.
kind Guard {
  :knows [Topic] default [bridge, toll]

  passage toll_speech   { Two coppers to cross, and no haggling. }
  passage bridge_speech { The bridge was here before the town was. }

  as target for ask {
    topic from :knows
    do {
      if (bound topic) {
        if (topic == :toll) { say toll_speech }
        else                { say bridge_speech }
      } else {
        say "The guard has nothing to say about that."
      }
    }
  }
}
