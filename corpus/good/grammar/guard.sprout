// The topics a guard hears are the ones it knows.
import {Topic} from 'study'
import {ask} from 'sprout'

kind Guard {
  :knows [Topic] default [bridge, old_press]

  as target for ask {
    topic from :knows
    do {
      if (bound topic) { say "The guard nods." } else { say "The guard shrugs." }
    }
  }
}
