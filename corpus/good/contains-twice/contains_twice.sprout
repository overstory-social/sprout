// `contains` and `contains actors` are idempotent, so a body writing
// either twice holds no more than it would with one line: the second is
// warned about where it is written, and the world still runs.
world contains_twice is sprout.World {
  visitors are Person
  visitors arrive at hall

  object hall is sprout.Place {
    object crate is Crate
    object den is sprout.Container {
      contains
      contains actors
    }
  }
}
