// The forms `tell` takes: `say` to the actor, `tell` to everyone else in
// the place, `tell <x>` to one person, and, from a teller that holds
// actors, `tell inside` to only its own occupants and `tell outside` to
// only the place around it. A wardrobe is a place inside the hall, so its
// plain `tell` reaches both whoever is inside it and the hall around it.
world audiences is sprout.World {
  visitors are Person
  visitors arrive at hall

  object hall is sprout.Place {
    object lever is Lever
    object bell is Bell
    object kiln is Kiln
    object cat is Cat
    object wardrobe is Wardrobe
  }
}

verb pull   { role target  "pull [target]" }
verb tag    { role target  "tag [target]" }
verb fire   { role target  "fire [target]" }
verb nuzzle { role target }
verb peer   { role target  "peer into [target]" }

message :rang
