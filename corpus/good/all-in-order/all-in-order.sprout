// `all` in a role that takes one thing (the spec's Parsing › Sequences,
// again and all): for an engine verb's open role, as `examine`'s target,
// it takes every thing in reach that is not a person and not the
// visitor's own place, whatever else plays it; for a world verb's open
// role some kind plays, as `polish`'s, only what plays a part in it; and
// for a role only the actor plays, as `take`'s, every thing that is not a
// person and not the visitor's own place. The reading runs once for each,
// in the order the range walk reaches them, and stops at the first
// refusal its turns meet, wherever in that order it falls. A run of things runs in the
// order written.
import * as sprout from 'sprout'
import {Person} from 'person'
import {examine} from 'sprout'

world all_in_order is sprout.World {
  visitors are Person
  visitors arrive at hall

  object hall is sprout.Place {
    grammar { article the }
    object apple is Plain { grammar { name "apple" } describe { text "A red apple." } }
    object bell is Shiny { grammar { name "bell" } describe { text "A brass bell." } }
    object lamp is Glare { grammar { name "lamp" } describe { text "A lamp." } }
    object mirror is Shiny { grammar { name "mirror" } describe { text "A silvered mirror." } }
    object pear is Plain { grammar { name "pear" } describe { text "A green pear." } }
  }
}

// Plays no part in any verb, and `examine all` still takes it.
kind Plain { }

verb polish { role target  "polish [target]" }

kind Shiny {
  as target for examine {
    permit { allow }
    do { broadcast :glint }
  }
  as target for polish {
    do { say "It gleams." }
  }
}

message :glint

// The lamp refuses to be examined once a shiny thing has glinted at it.
// As the line is read nothing has, so `all` keeps the lamp; by its turn
// the bell has, so the line stops there.
kind Glare {
  :dazzling false
  on :glint { self.set(:dazzling, true) }
  as target for examine {
    permit { if (self.get(:dazzling)) { refuse "Too bright to look at." } }
  }
}
