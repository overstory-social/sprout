// A lantern kindles whichever lamp is nearest it: the one its room holds
// when the body runs, wherever that lamp was declared or made, and nothing
// where the room holds none, since a send to a name that reaches nothing
// does nothing. Its wick is its own in every lantern, so the wick is read
// directly.
import {light, :kindle} from 'kinds'
import {Wick} from 'wick'
import {Oil} from 'oil'

kind Lantern {
  contains
  :lit false

  as target for light {
    do {
      self.set(:lit, wick.get(:trimmed))
      send lamp :kindle
      send wick :kindle
      say "The lantern catches."
    }
  }

  object wick is Wick
  object oil is Oil
}
