import * as sprout from 'sprout'
import {Visitor} from 'visitor'
import {Creature} from 'creature'

world visitor_kind is sprout.World {
  visitors are Visitor
  visitors arrive at kitchen

  object kitchen is sprout.Place {
    // An NPC made of `Creature` alone, with the same hands as a person.
    object cat is Creature
  }
}
