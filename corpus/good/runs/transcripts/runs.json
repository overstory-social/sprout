      { "level": "info", "text": "step: sprout.take" },
      { "reader": "Marta", "kind": "notice", "words": "(an iron key)" },
      { "reader": "Marta", "kind": "said", "words": "You take an iron key." },
      { "level": "warning", "text": "drawn: the line read 2 ways that tied, and one was drawn" }
    ] },
    { "as": "Marta", "type": "take shaker and look", "expect": [
