      { "reader": "Marta", "kind": "said", "words": "You take a bottle." },
      { "level": "info", "text": "step: sprout.take" },
      { "reader": "Marta", "kind": "said", "words": "You take the lamp." }
    ] },
    { "as": "Marta", "type": "drop sack and drop bottle", "expect": [
      { "reader": "Marta", "kind": "said", "words": "You put a sack down." },
      { "reader": "Marta", "kind": "said", "words": "You put a bottle down." }
    ] },
    { "as": "Marta", "type": "take sack and take bottle", "expect": [
      { "reader": "Marta", "kind": "said", "words": "You take a sack." },
      { "reader": "Marta", "kind": "said", "words": "You take a bottle." }
    ] },
