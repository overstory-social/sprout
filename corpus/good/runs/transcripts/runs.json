    ] },
    { "as": "Marta", "type": "juggle sack and bottle", "expect": [
      { "reader": "Marta", "kind": "said", "words": "You juggle 2 things at once." }
    ] },
    { "as": "Marta", "type": "take brass key", "expect": [
      { "reader": "Marta", "kind": "said", "words": "You take a brass key." }
    ] },
