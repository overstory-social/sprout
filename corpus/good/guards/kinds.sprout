kind Creature: sprout.Actor {
  :strength 5 min 0 max 9
}

// A lid and a capacity, and a passage for each refusal.
kind Crate {
  contains
  :open true
  :capacity 4 min 0 max 20

  accept (item, from) {
    if (!self.get(:open)) { refuse shut }
    else if (self.count >= self.get(:capacity)) { refuse full }
    else { allow }
  }
  release (item, to) {
    let lid = self.get(:open)
    if (!lid) { refuse shut }
  }
  depart (to) {
    // `to` is an object: narrowed to a creature, what a creature
    // declares is readable.
    if (to.is(Creature)) {
      if (to.get(:strength) < 3) { refuse "It is too heavy to lift." }
    }
  }

  passage shut { {self} is shut. }
  passage full { There is no room in {self}. }
}

// Nobody but the thing itself moves it.
kind Fragile {
  depart (to) { if (mover != self) { refuse "Careful: it would break." } }
}

// A vase is fragile, but not so fragile that it cannot be carried:
// it keeps what `Fragile` declares and leaves out its `depart`.
kind Vase: Fragile {
  :glazed true
  without depart from Fragile
}
