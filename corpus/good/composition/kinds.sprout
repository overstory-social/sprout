// A kind may compose any number of kinds, including none.
kind Wooden {
  :worn 0 min 0 max 9
}

kind Room {
  contains actors
}

kind Lidded: Wooden {
  contains
  :open true
}

kind Heavy: Wooden {
  :weight 40 min 0 max 200
}

// A diamond: `Wooden` is reached through both `Lidded` and `Heavy`.
// `:open` is restated, which keeps its type and changes its default.
kind Chest: Lidded, Heavy {
  :open false
  :remembers [opened: false]
}
