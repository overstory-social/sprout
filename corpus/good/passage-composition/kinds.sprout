kind Terse {
  passage unknown { No. }
}

kind Hushed {
  passage arrives { {item} slips in without a sound. }
}

kind Mirror {
  passage greeting { The glass is older than the frame. }
}

// A default, and a kind that composes it and writes its own line over it.
kind Plain {
  passage taken default { You take it. }
}

kind Bold: Plain {
  passage taken { You seize it. }
}

// A diamond: `Voice` is reached through both `Left` and `Right`, and its
// one default counts once.
kind Voice {
  passage shrug default { {self} gives nothing away. }
}

kind Left: Voice { }

kind Right: Voice { }

kind Both: Left, Right { }
