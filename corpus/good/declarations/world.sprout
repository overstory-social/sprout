// A printer's shop, as far as the compiler reads today: enums, messages,
// the world root, and the place visitors arrive at.
world shop is sprout.World {
  contains
  visitors are Creature
  visitors arrive at composing_room
  :season Season default autumn
  :ward Ward.iron
  :sign string default "back \{soon}"
  :grid [[Ward]] default [[iron], [brass, iron]]
  // What the shop remembers about each actor, written as properties are.
  remembers {
    :visits   0 min 0 max 99
    :greeted  false
    :ward_met Ward default brass
  }

  object composing_room is Room
}
