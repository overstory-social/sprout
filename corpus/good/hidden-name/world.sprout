// A nearer name wins, and hides the one further out: the world compiles,
// and the compiler says so at the inner declaration, naming the path the
// outer one is still reached by.
world hidden_name is sprout.World {
  visitors are Creature
  visitors arrive at shop_floor

  object shop_floor is sprout.Place {
    object key is Thing
    object lamp is Thing

    // Two chests side by side, each with a lid: neither is further out
    // than the other, so neither lid hides the other.
    object red_chest is Chest {
      // The chest's key hides the floor's from inside the chest. The
      // floor's is `shop_floor.key` there.
      object key is Thing
      object lid is Thing
    }

    object blue_chest is Chest {
      object lid is Thing
    }
  }

  // Directly in the world, and hidden inside the shop floor, where the
  // world's name reaches it: `hidden_name.lamp`.
  object lamp is Thing
}

kind Creature is sprout.Visitor { }
kind Chest { contains }
kind Thing { }
