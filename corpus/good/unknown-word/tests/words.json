{
  "about": "A line a verb's phrase reads whose noun names nothing in reach is `not_here`, whether a word of it names nothing in the world or names something elsewhere, unless the line's first words name something in reach, when the rest is dropped and they are read; a line no phrase reads is `unknown`, whatever its nouns.",
  "steps": [
    { "arrive": "Marta", "expect": [
      { "reader": "Marta", "kind": "described", "words": "There is nothing special about the hall." }
    ] },
    { "as": "Marta", "type": "take jewels", "expect": [
      { "reader": "Marta", "kind": "notice", "words": "You see nothing like that here." }
    ] },
    { "as": "Marta", "type": "examine fence", "expect": [
      { "reader": "Marta", "kind": "notice", "words": "You see nothing like that here." }
    ] },
    { "as": "Marta", "type": "put ball in jewels", "expect": [
      { "reader": "Marta", "kind": "notice", "words": "You see nothing like that here." }
    ] },
    { "as": "Marta", "type": "take ball again", "expect": [
      { "reader": "Marta", "kind": "notice", "words": "(take ball)" },
      { "reader": "Marta", "kind": "said", "words": "You take a ball." }
    ] },
    { "as": "Marta", "type": "take gong", "expect": [
      { "reader": "Marta", "kind": "notice", "words": "You see nothing like that here." }
    ] },
    { "as": "Marta", "type": "take the ball in the box", "expect": [
      { "reader": "Marta", "kind": "notice", "words": "(take the ball)" },
      { "reader": "Marta", "kind": "refused", "words": "You already have it." }
    ] },
    { "as": "Marta", "type": "drop everything", "expect": [
      { "reader": "Marta", "kind": "said", "words": "You put a ball down." }
    ] },
    { "as": "Marta", "type": "drop everything", "expect": [
      { "reader": "Marta", "kind": "notice", "words": "You see nothing like that here." }
    ] },
    { "as": "Marta", "type": "xyzzy jewels", "expect": [
      { "reader": "Marta", "kind": "notice", "words": "That is not something you can do here." }
    ] },
    { "as": "Marta", "type": "frobnicate the ball", "expect": [
      { "reader": "Marta", "kind": "notice", "words": "That is not something you can do here." }
    ] },
    { "as": "Marta", "type": "go jewels", "expect": [
      { "reader": "Marta", "kind": "notice", "words": "That is not something you can do here." }
    ] },
    { "as": "Marta", "type": "take ball", "expect": [
      { "reader": "Marta", "kind": "said", "words": "You take a ball." }
    ] }
  ]
}
