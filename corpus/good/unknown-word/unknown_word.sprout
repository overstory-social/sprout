// A noun naming nothing in reach, whatever its words (the spec's Parsing ›
// When nothing matches). Where a verb's phrase reads the line, a noun that
// names nothing here is `not_here`, whether its words name something
// elsewhere, as `gong` does from the cellar, or nothing in the world at all,
// as `jewels` and `ball again` do. A line no phrase reads is `unknown`.
import * as sprout from 'sprout'
import {Person} from 'person'

world unknown_word is sprout.World {
  visitors are Person
  visitors arrive at hall

  object hall is sprout.Place {
    grammar { article the  exit down "down" -> cellar }
    object ball is Toy { grammar { name "ball" } }
    object box is sprout.Container { grammar { name "box" } }
  }

  object cellar is sprout.Place {
    grammar { article the }
    object gong is Toy { grammar { name "gong" } }
  }
}

kind Toy { }
