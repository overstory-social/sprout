// A verb a visitor can type whose plays never `say` anything answers
// every command with the world's `nothing_happens`, so it is warned
// about; a verb with no phrases only an NPC performs, and is not.
world unsaid_verb is sprout.World {
  visitors are Person
  visitors arrive at hall

  object hall is sprout.Place {
    object lever is Lever
  }
}
verb pull { role target  "pull [target]" }
verb creak { role target }
