kind Creature is sprout.Visitor { }

kind Shelf { contains }

kind Wick { :trimmed true }

kind Flame { }

// Every lantern holds a wick, which holds a flame: what a kind's body
// holds may hold objects of its own.
kind Lantern {
  contains
  :lit false

  object wick is Wick {
    contains
    object flame is Flame
  }
}

// Opening the cupboard makes a lantern, wick and flame and all.
kind Cupboard {
  contains

  as target for open {
    do {
      spawn Lantern in self
      say "A lantern is waiting on the top shelf."
    }
  }
}

verb open { role target  "open [target]" }
