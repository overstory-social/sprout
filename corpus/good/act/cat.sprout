// A cat is a creature with nobody behind it. Petting it has it nuzzle
// whoever petted it, the same verb a visitor types, and then knead,
// which has no phrases, so only an `act` performs it, and whose optional
// tool is left out.
kind Cat is Creature {
  :moods [Mood] default [calm, sleepy]

  as target for pet {
    do {
      act nuzzle (target: actor)
      act knead (target: self)
      say "The cat settles."
    }
  }

  // A set is handed on whole, and one thing may stand for a set of one.
  as target for play {
    do {
      act bat (target: actor, toys: toys)
      act bat (target: actor, toys: self)
    }
  }

  // A value tool is handed on only where `bound` has said it is there.
  as target for quiz {
    topic from :moods
    do {
      if (bound topic) { act mew (target: actor, mood: topic) }
      else             { say "The cat looks away." }
    }
  }

  as actor for bat   { do { say "The cat bats at {target}." } }
  as actor for mew   { do { say "Mew." } }
  as actor for knead { do { say "The cat kneads the blanket." } }
}
