kind Cart is sprout.Place { }

kind Thing { }

// A shelf takes what it is named with onto itself, and says no when full.
// Where a visitor named a tool, the tool goes up too, read only once
// `bound` has said it is there.
kind Shelf {
  contains
  :capacity 3 min 0 max 9

  accept (item, from) {
    if (self.count >= self.get(:capacity)) { refuse "The shelf is full." }
  }

  as tool for shelve { do { move target to self  say "Up it goes." } }

  as target for tidy {
    do {
      if (bound tool) { move tool to self }
      say "The shelf looks tidier."
    }
  }
}

kind Sheet { }

// A new sheet is made in the press, then handed to whoever pulled.
kind Press {
  contains

  as target for pull {
    do {
      let sheet = spawn Sheet in self
      move sheet to actor
      say "A sheet slides out into your hands."
    }
  }
}

// A ball rolls to wherever the kicker stands.
kind Ball {
  as target for kick { do { move self to here  say "It rolls away across the floor." } }
}
