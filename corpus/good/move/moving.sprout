// `move`, as far as the compiler reads it today: a `do` proposes moving
// a thing into a container, the object whose body runs it is the mover,
// and the same three guards a typed command meets decide.
import * as sprout from 'sprout'
import {Person} from 'person'
import {Cart} from 'cart'
import {Shelf} from 'shelf'
import {Press} from 'press'
import {Ball} from 'ball'
import {Thing} from 'thing'
import {Cat} from 'cat'
import {Cupboard} from 'cupboard'

world moving is sprout.World {
  contains actors
  visitors are Person
  visitors arrive at hall

  // The engine refuses a move that would put a thing inside itself, in
  // the world's words where it writes them.
  passage inside_itself { {item} will not fit inside itself. }

  object cart is Cart
  object shelf is Shelf
  object press is Press
  object ball is Ball
  object duster is Thing
  object hall is sprout.Place {
    object cat is Cat { grammar { name "cat" article the } }
    object cupboard is Cupboard
  }
}

verb board  { role target: Cart  "board [target]"  "climb into [target]" }
verb shelve { role target  role tool: Shelf  "shelve [target] on [tool]" }
verb tidy   { role target: Shelf  role tool  "tidy [target] with [tool]"  "tidy [target]" }
verb pull   { role target  "pull [target]" }
verb kick   { role target  "kick [target]" }
verb shoo   { role target: Cat  "shoo [target]" }
