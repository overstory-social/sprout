// A shelf takes what it is named with onto itself, and says no when full.
// Where a visitor named a tool, the tool goes up too, read only once
// `bound` has said it is there.
kind Shelf {
  contains
  :capacity 3 min 0 max 9

  accept (item, from) {
    if (self.count >= self.get(:capacity)) { refuse "The shelf is full." }
  }

  as tool for shelve { do { move target to self  say "Up it goes." } }

  as target for tidy {
    do {
      if (bound tool) { move tool to self }
      say "The shelf looks tidier."
    }
  }
}
