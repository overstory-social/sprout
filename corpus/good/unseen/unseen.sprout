// Things in place and out of sight (the spec's Range › Unseen). The thief
// stands in the hall unseen: not listed, not named, and his comings and
// goings unannounced, while a message still reaches him and he still moves.
// Startled by the bell, he slips into the vault untold, and shows himself
// there; startled again by the gong, he is seen to go. An open niche is
// unseen, and so is the coin in it. The grating starts unseen under the leaves, and shows
// itself when they are swept aside, since only it writes its own
// `:unseen`. A lamp in the cellar is lit, and unseen, so it lights nothing.
import * as sprout from 'sprout'
import {Person} from 'person'

world unseen is sprout.World {
  visitors are Person
  visitors arrive at hall

  object hall is sprout.Place {
    grammar {
      article the
      exit north "north to the vault" -> vault
      exit down "down to the cellar" -> cellar
    }

    describe { text "A bare hall.{for x: Thing in self} You see {x}.{/for}" }

    object bell is Thing {
      grammar { name "bell" article a }
      as target for ring { do { say "The bell clangs."  send thief :startled } }
    }
    object leaves is Thing {
      grammar { name "heap of leaves" article a nouns "leaves" }
      as target for sweep { do { say "You sweep the leaves aside."  send grating :uncovered } }
    }
    object grating is Thing {
      grammar { name "grating" article a }
      :unseen true
      on :uncovered { self.set(:unseen, false) }
    }
    object thief is Thief
    object niche is Niche {
      object coin is Thing { grammar { name "coin" article a } }
    }
  }

  object vault is sprout.Place {
    grammar {
      article the
      exit south "south to the hall" -> hall
    }
    describe { text "A low vault." }

    object gong is Thing {
      grammar { name "gong" article a }
      as target for ring { do { say "The gong booms."  send hall.thief :startled } }
    }
  }

  object cellar is sprout.Place {
    grammar {
      article the
      lit (self.sees(sprout.LightSource, :lit))
      exit up "up to the hall" -> hall
    }
    describe { text "A dry cellar." }
    object lamp is Lamp
  }
}

message :startled
message :uncovered

verb ring  { role target  "ring [target]" }
verb sweep { role target  "sweep [target]"  "sweep aside [target]" }

kind Thing { }

kind Thief is sprout.Actor {
  grammar { name "thief" article the }
  :unseen true

  // Unseen as he goes to the vault, so that move is not told; seen once
  // he is there, so the next is.
  on :startled {
    if (self.get(:unseen)) {
      move self to vault
      self.set(:unseen, false)
    } else {
      move self to hall
    }
  }
}

// Open, and unseen: neither it nor the coin in it can be named.
kind Niche {
  contains
  grammar { name "niche" article a }
  :unseen true
  pass any (true)
}

kind Lamp is sprout.LightSource {
  grammar { name "lamp" article a }
  :lit true
  :unseen true
}
