verb sniff { role target  "sniff [target]" }
verb bark { role target  "bark at [target]" }
kind Sender {
  on :ping (who) {
    broadcast :c0 with 1
    broadcast :c1 with 1
    broadcast :c2 with 1
    broadcast :c3 with 1
    broadcast :c4 with 1
    broadcast :c5 with 1
    broadcast :c6 with 1
    broadcast :c7 with 1
    broadcast :c8 with 1
    broadcast :c9 with 1
    broadcast :c10 with 1
    broadcast :c11 with 1
    broadcast :c12 with 1
    broadcast :c13 with 1
    broadcast :c14 with 1
    broadcast :c15 with 1
    broadcast :c16 with 1
    broadcast :c17 with 1
    broadcast :c18 with 1
    broadcast :c19 with 1
    broadcast :c20 with 1
    broadcast :c21 with 1
    broadcast :c22 with 1
    broadcast :c23 with 1
    broadcast :c24 with 1
    broadcast :c25 with 1
    broadcast :c26 with 1
    broadcast :c27 with 1
    broadcast :c28 with 1
    broadcast :c29 with 1
    broadcast :c30 with 1
    broadcast :c31 with 1
    broadcast :c32 with 1
