}
verb p95 { role target  "p95 [target]" }
verb p96 { role target  "p96 [target]" }
verb p97 { role target  "p97 [target]" }
verb p98 { role target  "p98 [target]" }
kind Hall is sprout.Place {
  :arrivals 0 min 0 max 99
  on :entered (item, from) { self.adjust(:arrivals, 1) }
}
kind Tent is sprout.Place { }
kind Lodge is sprout.Place {
  :closed false
  accept (item, from) { if (self.get(:closed)) { refuse "Not tonight." } }
}
kind Wardrobe is sprout.Place {
  :open false
  pass any (self.get(:open))
  on :c91 (who, value) {
    tell inside "Welcome in."
  }
  on :c92 (who, value) {
    tell outside "Muffled."
  }
  on :c93 (who, value) {
    tell "A voice."
  }
}
kind Cell is sprout.Place {
  grammar { link onward "on" }
  on :c65 (who, value) {
    let c = spawn Cell in exec_bench.hall
    connect onward to c
  }
  on :c66 (who, value) {
    let c = spawn Cell in exec_bench.hall
    connect onward to c
    let d = spawn Cell in exec_bench.hall
    connect onward to d
  }
  on :c67 (who, value) {
    each t in exec_bench.hall.shelf { connect onward to t }
  }
}
kind Runner {
  contains
  :count 0 min 0 max 9
  :trail 0 min 0 max 99
  :pongs 0 min 0 max 99
  :label string default "salt"
  :glaze Glaze default shino
  :wards [Glaze] default [shino]
  remembers { :visits 0 min 0 max 9 }
  changed :count (was) { self.adjust(:trail, 1) }
  on :pong (from) { self.adjust(:pongs, 1) }
  on :woke (elapsed) { self.adjust(:count, 1) }
  passage named { Salt. }
  on :c0 (who, value) {
    let n = self.get(:count) + 2
    self.set(:count, n)
  }
  on :c1 (who, value) {
    self.set(:label, "sugar")
  }
  on :c2 (who, value) {
    self.set(:glaze, :tenmoku)
  }
  on :c3 (who, value) {
    self.adjust(:count, 5 + 5)
  }
  on :c4 (who, value) {
    self.adjust(:count, 0 - 9)
  }
  on :c5 (who, value) {
    self.add(:wards, :tenmoku)
  }
  on :c6 (who, value) {
    self.add(:wards, :shino)
  }
  on :c7 (who, value) {
    self.remove(:wards, :shino)
  }
  on :c8 (who, value) {
    self.remove(:wards, :tenmoku)
  }
  on :c9 (who, value) {
    self.add(:wards, :none)
  }
  on :c10 (who, value) {
    if (who.is(sprout.Actor)) { who.remember(:visits, 3) }
  }
  on :c11 (who, value) {
    if (who.is(sprout.Actor)) { who.adjust(:visits, 2) }
  }
  on :c12 (who, value) {
    if (who.is(sprout.Actor)) { who.adjust(:visits, 3) }
  }
  on :c13 (who, value) {
    self.set(:count, 6)
  }
  on :c14 (who, value) {
    self.set(:count, 4)
  }
  on :c15 (who, value) {
    self.set(:count, 1)
    self.set(:count, 2)
  }
  on :c16 (who, value) {
    self.set(:count, self.get(:count) + 12)
  }
  on :c17 (who, value) {
    self.set(:count, 7)
  }
  on :c18 (who, value) {
    tell "Text stands in."
  }
  on :c19 (who, value) {
    if (self.get(:count) == 0) { self.set(:label, "zero") } else { self.set(:label, "more") }
  }
  on :c20 (who, value) {
    if (self.get(:count) == 0) { self.set(:label, "none") } else { self.set(:label, "some") }
  }
  on :c21 (who, value) {
    if (self.get(:count) > 5) { self.set(:label, "big") } else if (self.get(:count) > 2) { self.set(:label, "mid") } else { self.set(:label, "low") }
  }
  on :c22 (who, value) {
    let a = 1
    if (a == 1) { let b = a + 1
    self.set(:count, b) }
  }
  on :c23 (who, value) {
    if (exec_bench.hall.shelf.is(Shelf)) { self.set(:count, exec_bench.hall.shelf.count) }
  }
  on :c24 (who, value) {
    each pot: Jar in exec_bench.hall.shelf { self.adjust(:count, 1) }
  }
  on :c25 (who, value) {
    each thing in exec_bench.hall.shelf { self.adjust(:count, 1) }
  }
  on :c26 (who, value) {
    each thing in exec_bench.hall.chest { self.adjust(:count, 2) }
  }
  on :c27 (who, value) {
    each thing in exec_bench.hall.chest { self.adjust(:count, 2) }
  }
  on :c28 (who, value) {
    each a in exec_bench.hall.shelf { each b in exec_bench.hall.shelf { self.adjust(:count, 1) } }
  }
  on :c29 (who, value) {
    each a in exec_bench.hall.shelf { each b in exec_bench.hall.shelf { self.adjust(:count, 3) } }
  }
  on :c30 (who, value) {
    each thing in exec_bench.hall.shelf { move thing to exec_bench.hall.basket }
  }
  on :c31 (who, value) {
    each thing in exec_bench.hall.shelf { move thing to exec_bench.hall.gate
    self.adjust(:count, 1) }
  }
  on :c32 (who, value) {
    move exec_bench.hall.shelf.jar to exec_bench.hall.basket
  }
  on :c33 (who, value) {
    move exec_bench.hall.lamp to exec_bench.hall.shelf
  }
  on :c34 (who, value) {
    move exec_bench.hall.stubborn to exec_bench.hall.shelf
  }
  on :c35 (who, value) {
    move exec_bench.hall.keeper.kept to exec_bench.hall.shelf
  }
  on :c36 (who, value) {
    move exec_bench.hall.keeper.kept to exec_bench.hall.basket
  }
  on :c37 (who, value) {
    move exec_bench.hall.shelf.jar to exec_bench.hall.gate
  }
  on :c38 (who, value) {
    move exec_bench.hall.lamp to exec_bench.hall.gate
  }
  on :c39 (who, value) {
    move exec_bench.hall.lamp to exec_bench.hall.shelf
    self.set(:label, "after")
  }
  on :c40 (who, value) {
    move exec_bench.hall.box to exec_bench.hall.box.inner
  }
  on :c41 (who, value) {
    move exec_bench.hall.lamp to who
  }
  on :c42 (who, value) {
    move who to exec_bench.hall.shelf
  }
  on :c43 (who, value) {
    move exec_bench.hall.lamp to who
  }
  on :c49 (who, value) {
    spawn Crate in exec_bench.hall
  }
  on :c50 (who, value) {
    spawn Crate in exec_bench.hall
  }
  on :c51 (who, value) {
    if (who.is(Spark)) { self.set(:count, who.get(:n) + 3) }
  }
  on :c53 (who, value) {
    move who to exec_bench.hall.basket
  }
  on :c54 (who, value) {
    spawn Jar in who
  }
  on :c55 (who, value) {
    spawn Jar in exec_bench.hall
  }
  on :c56 (who, value) {
    let j = spawn Jar in exec_bench.hall.shelf
    send j :ping
  }
  on :c57 (who, value) {
    spawn Crate in exec_bench.hall
  }
  on :c58 (who, value) {
    spawn Crate in exec_bench.hall
    spawn Jar in exec_bench.hall
  }
  on :c59 (who, value) {
    spawn Jar in who
  }
  on :c60 (who, value) {
    spawn Jar in who
  }
  on :c68 (who, value) {
    send exec_bench.hall.bell :ping
  }
  on :c69 (who, value) {
    send exec_bench.hall.bell :ping
    send exec_bench.hall.lamp :ping
  }
  on :c70 (who, value) {
    send exec_bench.hall.chest.coin :ping
  }
  on :c71 (who, value) {
    send exec_bench.hall.chest.coin :ping
  }
  on :c72 (who, value) {
    broadcast :ping
  }
  on :c73 (who, value) {
    broadcast :ping
  }
  on :c74 (who, value) {
    each thing in exec_bench.hall.glass { self.adjust(:count, 2) }
  }
  on :c75 (who, value) {
    send exec_bench.hall.bell :chain with 1
  }
  on :c76 (who, value) {
    send exec_bench.hall.bell :chain with 2
  }
  on :c77 (who, value) {
    send exec_bench.hall.bell :chain with 3
  }
  on :c78 (who, value) {
    self.set(:count, 3)
    send exec_bench.hall.bell :ping
  }
  on :c79 (who, value) {
    wake in 5 seconds
  }
  on :c80 (who, value) {
    wake in 3 hours
  }
  on :c81 (who, value) {
    wake in 2 minutes
    wake in 3 minutes
  }
  on :c82 (who, value) {
    wake in 3 hours
    wake in 2 minutes
  }
  on :c83 (who, value) {
    wake in 90 seconds
  }
  on :c84 (who, value) {
    cancel wakes
  }
  on :c85 (who, value) {
    cancel wakes
    wake in 3 minutes
  }
  on :c86 (who, value) {
    cancel wakes
    cancel wakes
  }
  on :c87 (who, value) {
    tell "Hello there."
  }
  on :c88 (who, value) {
    tell who "For you."
  }
  on :c89 (who, value) {
    tell who "Not for you."
  }
  on :c90 (who, value) {
    tell named
  }
  on :c94 (who, value) {
    let n = self.get(:count)
    tell "Count is {n}."
  }
  as target for p95 {
    do {
    say "You tap the runner."
    }
  }
  as target for p96 {
    do {
    say named
    }
  }
  as target for p97 {
    do {
    say "Aside."
    tell "Overheard."
    }
  }
  on :c103 (who, value) {
    media.show("purr.png", "a purr")
  }
  on :c104 (who, value) {
    media.show("purr.png", "a purr")
  }
  on :c105 (who, value) {
    slides.show("purr.png")
  }
}
kind Spark {
  :n 0 min 0 max 9
  on :q51 (who, value) {
    self.set(:n, 4)
    destroy self
  }
  on :q52 (who, value) {
    destroy self
  }
  on :c52 (who, value) {
    destroy self
  }
  on :q53 (who, value) {
    destroy self
  }
  on :c61 (who, value) {
    destroy self
    self.set(:n, 2)
  }
  on :c62 (who, value) {
    send exec_bench.hall.bell :pong
    finally destroy self
  }
}
kind Bubble {
  on :c63 (who, value) {
    send exec_bench.hall.bell :pong
    destroy self
  }
}
kind Crate {
  contains
  :n 0 min 0 max 9
  object lid is Jar
  on :q54 (who, value) {
    destroy self
  }
  on :c64 (who, value) {
    self.set(:n, 5)
    destroy self
  }
}
kind Dog is sprout.Actor {
  :sniffed 0 min 0 max 99
  as actor for sniff { do { self.adjust(:sniffed, 1) } }
  on :c44 (who, value) {
    move self to exec_bench.hall.tent
  }
  on :c45 (who, value) {
    move self to exec_bench.hall.lodge
  }
  on :c46 (who, value) {
    move self to exec_bench.hall.chest
  }
  on :c47 (who, value) {
    move who to exec_bench.hall.lodge
  }
  on :c48 (who, value) {
    move who to exec_bench.hall.lodge
  }
  as target for p98 {
    do {
    say "Woof."
    }
  }
  on :c99 (who, value) {
    act sniff (target: exec_bench.hall.lamp)
  }
  on :c100 (who, value) {
    act bark (target: exec_bench.hall.lamp)
    self.adjust(:sniffed, 5)
  }
  on :c101 (who, value) {
    act sniff (target: who)
  }
  on :c102 (who, value) {
    act sniff (target: exec_bench.hall.lamp)
  }
}
kind Shelf {
  contains
  :capacity 2 min 0 max 9
  :filled false
  accept (item, from) { if (self.count >= self.get(:capacity)) { refuse full } }
  passage full { No room on {self}. }
  on :entered (item, from) { self.set(:filled, true) }
  on :left (item, to) { self.set(:filled, false) }
}
kind Chest { contains  :open false  pass any (self.get(:open)) }
kind Box { contains }
kind Glass { contains  pass :ping (true)  pass any (false) }
kind Moth { :drawn false  on :ping (from) { self.set(:drawn, true) } }
kind Basket { contains  accept (item, from) { allow } }
kind Gate { contains  accept (item, from) { if (item.is(Jar)) { allow }
 refuse "Jars only." } }
kind Keeper { contains  release (item, to) { refuse "The keeper holds on." } }
kind Stubborn { depart (to) { refuse "It will not budge." } }
kind Lamp {
  :lit false
  on :ping (from) { self.set(:lit, true) }
  as target for bark { permit { refuse "The lamp is not listening." } }
}
kind Bell {
  :answers 0 min 0 max 99
  :depth 0 min 0 max 99
  on :ping (from) { self.adjust(:answers, 1)
 send from :pong }
  on :pong (from) { self.adjust(:answers, 5) }
  on :chain (_, n) { self.set(:depth, n)
 send self :chain with n + 1 }
}
kind Jar {
  :fill 3 min 0 max 9
  on :ping (from) { self.adjust(:fill, 1) }
  on :spawned (from) { self.set(:fill, 4) }
  on :moved (from, to) { self.adjust(:fill, 1) }
}
kind Cup { :fill 3 min 0 max 9 }
import * as sprout from 'sprout'
