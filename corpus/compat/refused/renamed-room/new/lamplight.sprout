// The cellar renamed the vault under a version that keeps saves: a save
// holds the cellar by its path, so the later build cannot read it.
import * as sprout from 'sprout'
import {Person} from 'person'
import {Lamp} from 'lamp'

world lamplight is sprout.World {
  visitors are Person
  visitors arrive at hall

  object hall is sprout.Place {
    grammar { name "hall" exit down "to the vault" -> vault }
    describe { text "A narrow hall." }
    object lamp is Lamp
  }
  object vault is sprout.Place {
    grammar { name "vault" exit up "to the hall" -> hall }
    describe { text "A damp cellar." }
  }
}

verb light { role target  "light [target]" }
