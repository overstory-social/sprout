import * as sprout from 'sprout'
import {light} from 'lamplight'

enum Flame { low, steady, roaring }

kind Lamp {
  :lit false
  :flame Flame default low
  :oil 5 min 0 max 9
  :polished false
  grammar { name "lamp" }
  describe { text "A brass lamp." }

  as target for light {
    do {
      self.set(:lit, true)
      self.set(:flame, :roaring)
      say "The lamp roars into light."
    }
  }
}
