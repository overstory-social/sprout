{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sprout",
  "scopeName": "source.sprout",
  "fileTypes": ["sprout"],
  "patterns": [
    {
      "name": "comment.block.sprout",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.sprout" } },
      "endCaptures": { "0": { "name": "punctuation.definition.comment.end.sprout" } }
    },
    {
      "name": "comment.line.double-slash.sprout",
      "begin": "//",
      "end": "$",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.sprout" } }
    },
    { "include": "source.sprout-prose#passage" },
    { "include": "#declarations" },
    {
      "begin": "\\b(say|tell|text|refuse)\\b(?:\\s+([a-z_][a-z0-9_]*(?:\\.[a-z_][a-z0-9_]*)*))?\\s*(?=\")",
      "end": "(?<=\")|$",
      "beginCaptures": {
        "1": { "name": "keyword.other.sprout" },
        "2": { "patterns": [{ "include": "#words" }] }
      },
      "patterns": [
        {
          "name": "string.quoted.double.sprout",
          "contentName": "meta.embedded.line.sprout-prose",
          "begin": "\"",
          "end": "\"|$",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.sprout" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.sprout" } },
          "patterns": [{ "include": "source.sprout-prose#inline" }]
        }
      ]
    },
    {
      "name": "string.quoted.double.sprout",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.sprout" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.sprout" } },
      "patterns": [
        { "name": "constant.character.escape.sprout", "match": "\\\\[\"\\\\n{]" },
        { "match": "\\\\." }
      ]
    },
    { "include": "#words" }
  ],
  "repository": {
    "declarations": {
      "patterns": [
        {
          "match": "^\\s*(extension)\\s+([a-z_][a-z0-9_]*)\\s+([0-9]+)\\b",
          "captures": {
            "1": { "name": "keyword.other.sprout" },
            "2": { "name": "entity.name.namespace.sprout" },
            "3": { "name": "constant.numeric.integer.sprout" }
          }
        },
        {
          "match": "\\b(kind)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.sprout" },
            "2": { "name": "entity.name.type.kind.sprout" }
          }
        },
        {
          "name": "meta.enum.sprout",
          "begin": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
          "end": "\\}",
          "beginCaptures": {
            "1": { "name": "keyword.other.sprout" },
            "2": { "name": "entity.name.type.enum.sprout" },
            "3": { "name": "punctuation.section.block.begin.sprout" }
          },
          "endCaptures": { "0": { "name": "punctuation.section.block.end.sprout" } },
          "patterns": [
            {
              "name": "comment.block.sprout",
              "begin": "/\\*",
              "end": "\\*/",
              "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.sprout" } },
              "endCaptures": { "0": { "name": "punctuation.definition.comment.end.sprout" } }
            },
            {
              "name": "comment.line.double-slash.sprout",
              "begin": "//",
              "end": "$",
              "beginCaptures": { "0": { "name": "punctuation.definition.comment.sprout" } }
            },
            { "name": "variable.other.enummember.sprout", "match": "\\b[a-z_][a-z0-9_]*\\b" },
            { "name": "punctuation.separator.sprout", "match": "," }
          ]
        },
        {
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.sprout" },
            "2": { "name": "entity.name.type.enum.sprout" }
          }
        },
        {
          "match": "^\\s*(world|object)\\s+([a-z_][a-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.sprout" },
            "2": { "name": "entity.name.tag.object.sprout" }
          }
        },
        {
          "match": "\\b(message)\\s+(:)([a-z][a-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.sprout" },
            "2": { "name": "punctuation.definition.symbol.sprout" },
            "3": { "name": "constant.other.symbol.sprout entity.name.function.message.sprout" }
          }
        },
        {
          "name": "meta.verb.sprout",
          "begin": "\\b(verb)\\s+([a-z_][a-z0-9_]*)\\s*(\\{)",
          "end": "\\}",
          "beginCaptures": {
            "1": { "name": "keyword.other.sprout" },
            "2": { "name": "entity.name.function.verb.sprout" },
            "3": { "name": "punctuation.section.block.begin.sprout" }
          },
          "endCaptures": { "0": { "name": "punctuation.section.block.end.sprout" } },
          "patterns": [
            {
              "name": "comment.block.sprout",
              "begin": "/\\*",
              "end": "\\*/",
              "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.sprout" } },
              "endCaptures": { "0": { "name": "punctuation.definition.comment.end.sprout" } }
            },
            {
              "name": "comment.line.double-slash.sprout",
              "begin": "//",
              "end": "$",
              "beginCaptures": { "0": { "name": "punctuation.definition.comment.sprout" } }
            },
            {
              "name": "string.quoted.double.phrase.sprout",
              "begin": "\"",
              "end": "\"|$",
              "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.sprout" } },
              "endCaptures": { "0": { "name": "punctuation.definition.string.end.sprout" } },
              "patterns": [
                { "name": "constant.character.escape.sprout", "match": "\\\\[\"\\\\n{]" },
                { "match": "\\\\." },
                {
                  "match": "(\\[)\\s*([a-z_][a-z0-9_]*)\\s*(\\])",
                  "captures": {
                    "1": { "name": "punctuation.definition.role.begin.sprout" },
                    "2": { "name": "variable.parameter.role.sprout" },
                    "3": { "name": "punctuation.definition.role.end.sprout" }
                  }
                }
              ]
            },
            { "include": "$self" }
          ]
        },
        {
          "match": "\\b(verb)\\s+([a-z_][a-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.sprout" },
            "2": { "name": "entity.name.function.verb.sprout" }
          }
        },
        {
          "match": "\\b(as)\\s+([a-z_][a-z0-9_]*)\\s+(for)\\s+([a-z_][a-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.sprout" },
            "2": { "name": "variable.parameter.role.sprout" },
            "3": { "name": "keyword.other.sprout" },
            "4": { "name": "entity.name.function.verb.sprout" }
          }
        },
        {
          "match": "\\b(role)\\s+([a-z_][a-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.sprout" },
            "2": { "name": "variable.parameter.role.sprout" }
          }
        },
        {
          "match": "\\b(exit|link|connect)\\s+([a-z_][a-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.sprout" },
            "2": { "name": "entity.name.label.sprout" }
          }
        }
      ]
    },
    "words": {
      "patterns": [
        { "name": "constant.language.boolean.sprout", "match": "\\b(?:false|true)\\b" },
        {
          "name": "storage.type.sprout",
          "match": "\\b(?:boolean|integer|object|string|symbol)\\b"
        },
        {
          "name": "keyword.other.sprout",
          "match": "\\b(?:broadcast|remembers|contains|describe|optional|visitors|article|changed|connect|default|destroy|finally|grammar|message|minutes|passage|release|seconds|without|accept|actors|arrive|depart|import|permit|refuse|allow|bound|hours|nouns|prose|spawn|world|each|else|enum|exit|from|kind|link|many|move|name|pass|role|send|tell|text|verb|wake|when|with|act|any|are|for|let|max|min|say|as|at|do|if|in|of|on|to)\\b"
        },
        { "name": "keyword.other.sprout", "match": "\\bis\\b(?!\\s*\\()" },
        { "name": "variable.language.sprout", "match": "\\b(?:self|actor|here)\\b" },
        {
          "match": "\\b([a-z_][a-z0-9_]*)(\\.)([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.namespace.sprout" },
            "2": { "name": "punctuation.accessor.sprout" },
            "3": { "name": "entity.name.type.sprout" }
          }
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)(\\.)([a-z_][a-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.type.sprout" },
            "2": { "name": "punctuation.accessor.sprout" },
            "3": { "name": "variable.other.enummember.sprout" }
          }
        },
        {
          "match": "(:)([a-z][a-z0-9_]*)",
          "name": "constant.other.symbol.sprout",
          "captures": { "1": { "name": "punctuation.definition.symbol.sprout" } }
        },
        { "name": "constant.numeric.integer.sprout", "match": "\\b[0-9]+\\b" },
        {
          "name": "entity.name.type.sprout",
          "match": "(?:\\b|(?<=[a-z0-9_]))[A-Z][A-Za-z0-9_]*\\b"
        },
        { "name": "entity.name.function.sprout", "match": "\\b[a-z_][a-z0-9_]*(?=\\s*\\()" },
        { "name": "variable.other.sprout", "match": "\\b[a-z_][a-z0-9_]*" },
        { "name": "keyword.operator.arrow.sprout", "match": "->" },
        { "name": "keyword.operator.sprout", "match": "==|!=|<=|>=|&&|\\|\\||[<>!=+\\-*/]" },
        { "name": "punctuation.section.block.begin.sprout", "match": "\\{" },
        { "name": "punctuation.section.block.end.sprout", "match": "\\}" },
        { "name": "punctuation.section.brackets.sprout", "match": "[\\[\\]]" },
        { "name": "punctuation.section.parens.sprout", "match": "[()]" },
        { "name": "punctuation.separator.sprout", "match": "," },
        { "name": "punctuation.accessor.sprout", "match": "\\." },
        { "name": "punctuation.separator.label.sprout", "match": ":" }
      ]
    }
  }
}
